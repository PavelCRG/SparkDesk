import { Button, LineEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "SparkDesk";
    icon: @image-url("brand/logo-01-bridge.svg");
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 980px;
    min-height: 740px;
    background: #0b1018;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    in-out property <bool> english: false;
    in property <int> network-state: 0;
    in property <int> notice-state: 0;
    in property <string> notice-detail: "";
    in property <string> device-id: "";
    in-out property <string> peer-id: "";
    callback copy-id();
    callback connect(peer-id: string);

    forward-focus: shortcuts;

    function network-label() -> string {
        if root.network-state == 1 { return root.english ? "Connecting…" : "Подключаемся…"; }
        if root.network-state == 2 { return root.english ? "Online" : "В сети"; }
        if root.network-state == 3 { return root.english ? "Reconnecting…" : "Восстанавливаем связь…"; }
        return root.english ? "Server not configured" : "Сервер не настроен";
    }

    function localized-notice-detail() -> string {
        if !root.english { return root.notice-detail; }
        if root.notice-detail == "укажите базовый ws:// или wss:// адрес без параметров" {
            return "Use a base ws:// or wss:// address without parameters";
        }
        if root.notice-detail == "сервер закрыл соединение" { return "The server closed the connection"; }
        if root.notice-detail == "сервер прислал неверное сообщение" { return "The server sent an invalid message"; }
        if root.notice-detail == "версия протокола не совпадает" { return "The protocol version does not match"; }
        if root.notice-detail == "неверный challenge сервера" { return "The server challenge is invalid"; }
        if root.notice-detail == "сервер вернул другой ID" { return "The server returned a different ID"; }
        if root.notice-detail == "сервер отклонил сообщение" { return "The server rejected the message"; }
        return root.notice-detail;
    }

    function notice-label() -> string {
        if root.notice-state == 1 { return root.english ? "Device ID copied" : "ID устройства скопирован"; }
        if root.notice-state == 2 { return root.english ? "Could not copy device ID" : "Не удалось скопировать ID"; }
        if root.notice-state == 3 {
            return (root.english ? "Connection request from " : "Запрос на подключение от ") + root.notice-detail;
        }
        if root.notice-state == 4 {
            return (root.english ? "Connection issue: " : "Проблема с подключением: ") + root.localized-notice-detail();
        }
        if root.notice-state == 5 { return root.english ? "Connections are not available in this prototype yet" : "Подключение пока недоступно в прототипе"; }
        if root.notice-state == 6 { return root.english ? "Enter a valid 24-character device ID" : "Введите корректный ID из 24 шестнадцатеричных символов"; }
        if root.notice-state == 7 { return root.english ? "You cannot connect to this device" : "Нельзя подключиться к этому же устройству"; }
        return root.english ? "No account or extra setup required" : "Без регистрации и лишних шагов";
    }

    shortcuts := FocusScope {
        KeyBinding {
            keys: @keys(Control + Shift + C);
            activated => { root.copy-id(); }
        }
        KeyBinding {
            keys: @keys(Control + L);
            activated => { peer-input.focus(); }
        }
        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: 58px;
                background: #090e15;
                WindowMoveArea { width: 100%; height: 100%; }

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 8px;
                    spacing: 10px;

                    Image {
                        source: @image-url("brand/logo-01-bridge.svg");
                        width: 36px;
                        height: 36px;
                        cross-axis-self-alignment: center;
                    }
                    VerticalLayout {
                            spacing: 2px;
                            cross-axis-self-alignment: start;
                            Text { text: "SparkDesk"; color: #eef3fb; font-size: 14px; font-weight: 650; }
                            Text { text: root.english ? "REMOTE DESKTOP" : "УДАЛЁННЫЙ РАБОЧИЙ СТОЛ"; color: #8291a6; font-size: 9px; font-weight: 650; letter-spacing: 0.8px; }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Button {
                            width: 46px;
                            height: 34px;
                        text: root.english ? "EN" : "RU";
                        accessible-label: root.english ? "EN — switch language to Russian" : "RU — переключить язык на английский";
                            clicked => { root.english = !root.english; }
                            Tooltip { text: root.english ? @markdown("Переключить на русский") : @markdown("Switch to English"); }
                        }

                        Rectangle { width: 1px; height: 18px; background: #273345; cross-axis-self-alignment: center; }

                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 4px;
                            background: root.network-state == 2 ? #55d2a4 : root.network-state == 1 ? #7bb4f4 : #e0ac68;
                            cross-axis-self-alignment: center;
                        }
                        Text { text: root.network-label(); color: #adb9c9; font-size: 12px; vertical-alignment: center; min-width: 150px; overflow: elide; }

                        Button {
                            width: 36px;
                            height: 36px;
                            icon: @image-url("icons/minimize.svg"); icon-size: 14px; colorize-icon: true;
                            accessible-label: root.english ? "Minimize window" : "Свернуть окно";
                            clicked => { root.minimized = true; }
                            Tooltip { text: root.english ? @markdown("Minimize") : @markdown("Свернуть"); }
                        }
                        Button {
                            width: 36px;
                            height: 36px;
                            icon: @image-url("icons/maximize.svg"); icon-size: 14px; colorize-icon: true;
                            accessible-label: root.english ? "Maximize window" : "Развернуть окно";
                            clicked => { root.maximized = !root.maximized; }
                            Tooltip { text: root.english ? @markdown("Maximize") : @markdown("Развернуть"); }
                        }
                        Button {
                            width: 36px;
                            height: 36px;
                            icon: @image-url("icons/close.svg"); icon-size: 14px; colorize-icon: true;
                            accessible-label: root.english ? "Close SparkDesk" : "Закрыть SparkDesk";
                            clicked => { root.close(); }
                            Tooltip { text: root.english ? @markdown("Close") : @markdown("Закрыть"); }
                        }
                    }
                }

                Rectangle { height: 1px; background: #202a38; }

                VerticalLayout {
                    padding-left: 48px;
                    padding-right: 48px;
                    padding-top: 30px;
                    padding-bottom: 22px;
                    spacing: 22px;

                    VerticalLayout {
                        spacing: 9px;
                        Text { text: root.english ? "PRIVATE REMOTE DESKTOP  ·  PROTOTYPE" : "УДАЛЁННЫЙ РАБОЧИЙ СТОЛ  ·  ПРОТОТИП"; color: #8eb4f1; font-size: 11px; font-weight: 700; letter-spacing: 1.1px; }
                        Text {
                            text: root.english ? "Remote help,\nwith your permission." : "Удалённая помощь —\nс вашего разрешения.";
                            color: #f2f5fb;
                            font-size: 34px;
                            font-weight: 700;
                            line-height-factor: 1.06;
                        }
                        Text {
                            text: root.english
                                ? "Share your device ID or enter a partner’s. Access always starts with the owner’s approval."
                                : "Поделитесь ID своего устройства или введите ID партнёра. Доступ всегда начинается с разрешения владельца.";
                            color: #aab6c7;
                            font-size: 14px;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        spacing: 20px;
                        height: 302px;

                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            border-radius: 18px;
                            background: #121b28;
                            border-width: 1px;
                            border-color: #2b3d56;

                            VerticalLayout {
                                padding: 24px;
                                spacing: 14px;

                                HorizontalLayout {
                                    height: 30px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 30px;
                                        height: 30px;
                                        border-radius: 9px;
                                        background: #1b2d45;
                                        Text { text: "01"; color: #a9c8f5; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: root.english ? "YOUR DEVICE" : "ВАШЕ УСТРОЙСТВО"; color: #b5c2d3; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: root.english ? "OWNER APPROVAL REQUIRED" : "С СОГЛАСИЯ ВЛАДЕЛЬЦА"; color: #77d0ab; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                }

                                Text { text: root.english ? "Your device ID" : "Ваш ID устройства"; color: #e4eaf3; font-size: 15px; font-weight: 600; }

                                Rectangle {
                                    height: 50px;
                                    border-radius: 11px;
                                    background: #0c131d;
                                    border-width: 1px;
                                    border-color: #30435d;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        Text {
                                            text: root.device-id;
                                            color: #f4f7fc;
                                            font-size: 18px;
                                            font-weight: 700;
                                            letter-spacing: 1px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            overflow: elide;
                                        }
                                    }
                                }

                                Button {
                                    horizontal-stretch: 1;
                                    height: 46px;
                                    text: root.english ? "Copy device ID" : "Копировать ID устройства";
                                    icon: @image-url("icons/copy.svg");
                                    icon-size: 16px;
                                    colorize-icon: true;
                                    accessible-label: root.english ? "Copy device ID" : "Копировать ID устройства";
                                    clicked => { root.copy-id(); }
                                    Tooltip { text: root.english ? @markdown("Copy device ID · Ctrl+Shift+C") : @markdown("Копировать ID · Ctrl+Shift+C"); }
                                }

                                Text {
                                    text: root.english
                                        ? "Share this ID with your partner. It does not grant access by itself."
                                        : "Передайте этот ID партнёру. Сам по себе он не открывает доступ к экрану.";
                                    color: #94a2b5;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    min-width: 0px;
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            border-radius: 18px;
                            background: #111a27;
                            border-width: 1px;
                            border-color: #273649;

                            VerticalLayout {
                                padding: 24px;
                                spacing: 14px;

                                HorizontalLayout {
                                    height: 30px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 30px;
                                        height: 30px;
                                        border-radius: 9px;
                                        background: #1b2d45;
                                        Text { text: "02"; color: #a9c8f5; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: root.english ? "NEW CONNECTION" : "НОВОЕ ПОДКЛЮЧЕНИЕ"; color: #b5c2d3; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; vertical-alignment: center; }
                                }

                                HorizontalLayout {
                                    Text { text: root.english ? "Partner device ID" : "ID удалённого компьютера"; color: #e4eaf3; font-size: 15px; font-weight: 600; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: "Ctrl+L"; color: #8491a4; font-size: 10px; vertical-alignment: center; }
                                }

                                peer-input := LineEdit {
                                    horizontal-stretch: 1;
                                    height: 50px;
                                    text <=> root.peer-id;
                                    placeholder-text: root.english ? "Enter the 24-character device ID" : "Введите 24-значный ID устройства";
                                    accessible-label: root.english ? "Partner device ID, 24 characters" : "ID удалённого компьютера, 24 символа";
                                    min-width: 0px;
                                    accepted(value) => { root.connect(value); }
                                }

                                Button {
                                    horizontal-stretch: 1;
                                    height: 46px;
                                    primary: true;
                                    enabled: root.peer-id != "";
                                    text: root.english ? "Connect" : "Подключиться";
                                    icon: @image-url("icons/arrow-right.svg");
                                    icon-size: 16px;
                                    colorize-icon: true;
                                    accessible-label: root.english ? "Connect to partner device" : "Подключиться к компьютеру партнёра";
                                    clicked => { root.connect(root.peer-id); }
                                    Tooltip { text: root.english ? @markdown("Connect · Enter") : @markdown("Подключиться · Enter"); }
                                }

                                Text {
                                    text: root.english
                                        ? "Remote sessions are not available in this prototype yet."
                                        : "Удалённые сеансы пока недоступны в этом прототипе.";
                                    color: #94a2b5;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    min-width: 0px;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 82px;
                        border-radius: 15px;
                        background: #101b1b;
                        border-width: 1px;
                        border-color: #25413a;
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 14px;
                            Image { source: @image-url("icons/shield-check.svg"); width: 22px; height: 22px; colorize: #71cfaa; cross-axis-self-alignment: center; }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: root.english ? "Your permission comes first" : "Сначала — ваше разрешение"; color: #e0eee8; font-size: 13px; font-weight: 650; }
                                Text {
                                    text: root.english
                                        ? "An ID is an address, not a password. Screen sharing and remote control are not implemented yet."
                                        : "ID — это адрес, а не пароль. Передача экрана и управление пока не реализованы.";
                                    color: #9bb2a8;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    min-width: 0px;
                                }
                            }
                            Rectangle { width: 1px; height: 34px; background: #2b403a; cross-axis-self-alignment: center; }
                            Text {
                                text: root.notice-label();
                                color: #c1cbd7;
                                font-size: 12px;
                                width: 240px;
                                wrap: word-wrap;
                                vertical-alignment: center;
                                accessible-role: text;
                                accessible-live-region: polite;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        height: 20px;
                        Text { text: root.english ? "SPARKDESK  ·  BUILT FOR DIRECT CONNECTION" : "SPARKDESK  ·  СПРОЕКТИРОВАН ДЛЯ ПРЯМОГО СОЕДИНЕНИЯ"; color: #8592a4; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.english ? "NO ACCOUNT REQUIRED" : "БЕЗ УЧЁТНОЙ ЗАПИСИ"; color: #8592a4; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; }
                    }
        }
    }
}
}

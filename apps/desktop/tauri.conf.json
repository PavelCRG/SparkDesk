{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SparkDesk",
  "version": "0.1.0",
  "identifier": "com.sparkdesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui-react/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SparkDesk",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis", "msi"]
  }
}

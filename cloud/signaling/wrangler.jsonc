{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sparkdesk-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE_HUB", "class_name": "DeviceHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceHub"] }
  ]
}
